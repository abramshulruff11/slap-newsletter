# Copy this file to ".env" and fill in ONE auth method.
# .env is gitignored -- never commit real credentials.

# Your publication URL (recommended so the right pub is targeted):
SUBSTACK_PUBLICATION_URL=https://yourpublication.substack.com

# --- Auth: pick ONE of the three options below ---

# Option 1 (recommended): path to a cookies json file.
# Substack increasingly uses passwordless "magic link" login, so email+password
# may not work. The reliable route is to log into Substack in your browser, then
# export your cookies. See README.md "Getting cookies".
# SUBSTACK_COOKIES_PATH=cookies.json

# Option 2: paste the cookie header string copied from browser dev tools.
# SUBSTACK_COOKIES_STRING=substack.sid=s%3A...; other=...

# Option 3: email + password (only works on password-based accounts).
# SUBSTACK_EMAIL=you@example.com
# SUBSTACK_PASSWORD=your-password
