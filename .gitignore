.env
__pycache__/
*.pyc
pass1_debug.txt
.claude/
python
Archive/
prompts/Archive/
game_state.json
# Daily build artifact. ANCHORED with a leading slash on purpose: a bare
# pattern matches at every level, which would also hide the archived copy at
# archive/<date>/story_plan.json — and `git add archive/` skips ignored files
# silently, so the record A4 exists to keep would never have been committed.
# (The !uat/fixtures/game_state.json negation below is the same trap, patched
# after the fact rather than anchored.)
/story_plan.json
prototype/output/

# UAT sandbox (uat/media-mix) — generated output only.
# uat/fixtures/ is deliberately NOT ignored: the frozen input is the control.
uat/output/
uat/media/
uat/probe/
!uat/fixtures/
!uat/fixtures/game_state.json

# GIF library — auto-made backups (apply_gif_decisions.py) and the
# regenerated review page/export (review_gifs.py, gif_review.html) are
# reproducible from the tracked library file; not worth tracking themselves.
prompts/gif_library.DRAFT.backup-*.json
uat/gif_review.html
uat/gif_decisions.json

# Meme library — same deal (review_memes.py, apply_meme_decisions.py). The
# render cache holds Imgflip URLs for each template's worked example; it is
# free to rebuild and re-renders on demand.
prompts/meme_library.DRAFT.backup-*.json
uat/meme_review.html
uat/meme_decisions.json
uat/meme_review_cache.json

# GIF URL cache — build artifact, regenerated per run
gif_url_cache.json

# Per-run status, read by verify_run.py. Build artifact, regenerated each run.
run_status.json

# library_studio_server.py keeps a .bak beside each library it writes, and
# writes through a .tmp. Neither belongs in git — the library itself is the record.
prompts/*.bak
prompts/*.tmp

# Per-stage logs teed by ci/run_stage.sh, and the midday publish's machine-
# readable outcome. Both are per-run build artifacts; what matters from them
# is already copied into run_status.json / the status email.
ci_logs/
publish_result.json
publish.log
